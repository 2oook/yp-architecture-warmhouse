@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Диаграмма компонентов Telemetry Service (to-be)

Container(apiGateway, "API Gateway", "Kong", "Единая точка входа")

Container_Boundary(telemetryService, "Telemetry Service") {
    Component(telemetryController, "Telemetry Controller", "Go, REST", "Эндпоинты просмотра текущих показаний и истории")
    Component(mqttSubscriber, "MQTT Subscriber", "Go, MQTT", "Приём показаний от устройств")
    Component(telemetryServiceComp, "Telemetry Service", "Go", "Проверка и сохранение показаний, выдача телеметрии")
    Component(telemetryRepository, "Telemetry Repository", "Go", "Доступ к показаниям")
    Component(eventPublisher, "Telemetry Event Publisher", "Go, Kafka", "Публикация событий о новых показаниях")
}

ContainerDb(telemetryDb, "Telemetry DB", "TimescaleDB", "Показания устройств во времени")
ContainerQueue(mqttBroker, "Device Broker", "MQTT", "Обмен сообщениями с устройствами")
ContainerQueue(eventBus, "Event Bus", "Kafka", "Обмен событиями между сервисами")

Rel(apiGateway, telemetryController, "Просмотр телеметрии", "REST/JSON")
Rel(mqttBroker, mqttSubscriber, "Показания устройств", "MQTT")
Rel(telemetryController, telemetryServiceComp, "Запрашивает показания")
Rel(mqttSubscriber, telemetryServiceComp, "Передаёт показания")
Rel(telemetryServiceComp, telemetryRepository, "Читает и записывает показания")
Rel(telemetryServiceComp, eventPublisher, "Передаёт новые показания")
Rel(telemetryRepository, telemetryDb, "Читает и записывает", "SQL")
Rel(eventPublisher, eventBus, "Новые показания", "Kafka")

SHOW_LEGEND()
@enduml
