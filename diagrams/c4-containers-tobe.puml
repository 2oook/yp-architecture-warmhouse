@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров экосистемы "Тёплый дом" (to-be)

Person(user, "User", "Регистрируется, подключает и настраивает устройства, управляет ими, настраивает сценарии, просматривает телеметрию")
Person(supportAgent, "Support Agent", "Сотрудник поддержки, обрабатывает обращения пользователей")

System_Ext(devices, "Smart Devices", "Устройства партнёров: отопление, свет, ворота, камеры, датчики")

System_Boundary(smarthome, "Smart Home Ecosystem") {
    Container(webApp, "Web App", "SPA", "Личный кабинет пользователя и интерфейс поддержки")
    Container(apiGateway, "API Gateway", "Kong", "Единая точка входа, проверка токена, маршрутизация запросов")

    Container(identityService, "Identity Service", "Go", "Identity Context: регистрация, вход, учётные записи, выдача токенов")
    ContainerDb(identityDb, "Identity DB", "PostgreSQL", "Пользователи, учётные данные")

    Container(supportService, "Customer Support Service", "Go", "Customer Support Context: обращения пользователей и их статусы")
    ContainerDb(supportDb, "Support DB", "PostgreSQL", "Обращения, ответы")

    Container(registryService, "Device Registry Service", "Go", "Device Registry Context: подключение и настройка устройств, привязка к пользователю")
    ContainerDb(registryDb, "Device Registry DB", "PostgreSQL", "Устройства, типы, владельцы, настройки")

    Container(controlService, "Device Control Service", "Go", "Device Control Context: отправка команд устройствам, статусы команд")
    ContainerDb(controlDb, "Device Control DB", "PostgreSQL", "Команды и их статусы")

    Container(telemetryService, "Telemetry Service", "Go", "Telemetry Context: приём и хранение показаний, выдача телеметрии пользователю")
    ContainerDb(telemetryDb, "Telemetry DB", "TimescaleDB", "Показания устройств во времени")

    Container(automationService, "Automation Service", "Go", "Automation Context: правила, расписания, выполнение сценариев")
    ContainerDb(automationDb, "Automation DB", "PostgreSQL", "Сценарии, правила, расписания")

    ContainerQueue(mqttBroker, "Device Broker", "MQTT", "Обмен сообщениями с устройствами: команды и показания")
    ContainerQueue(eventBus, "Event Bus", "Kafka", "Обмен событиями между сервисами")
}

Rel(user, webApp, "Использует", "HTTPS")
Rel(supportAgent, webApp, "Обрабатывает обращения", "HTTPS")
Rel(webApp, apiGateway, "Вызывает API", "HTTPS, REST/JSON")

Rel(apiGateway, identityService, "Регистрация, вход, проверка токена", "REST/JSON")
Rel(apiGateway, supportService, "Обращения", "REST/JSON")
Rel(apiGateway, registryService, "Подключение и настройка устройств", "REST/JSON")
Rel(apiGateway, controlService, "Команды устройствам", "REST/JSON")
Rel(apiGateway, telemetryService, "Просмотр телеметрии", "REST/JSON")
Rel(apiGateway, automationService, "Настройка сценариев", "REST/JSON")

Rel(identityService, identityDb, "Читает и записывает", "SQL")
Rel(supportService, supportDb, "Читает и записывает", "SQL")
Rel(registryService, registryDb, "Читает и записывает", "SQL")
Rel(controlService, controlDb, "Читает и записывает", "SQL")
Rel(telemetryService, telemetryDb, "Читает и записывает", "SQL")
Rel(automationService, automationDb, "Читает и записывает", "SQL")

Rel(devices, mqttBroker, "Публикуют показания, получают команды", "MQTT over TLS")
Rel(controlService, mqttBroker, "Публикует команды, получает подтверждения", "MQTT")
Rel(telemetryService, mqttBroker, "Подписывается на показания", "MQTT")

Rel(registryService, eventBus, "Публикует события: устройство подключено, удалено, изменено", "Kafka")
Rel(telemetryService, eventBus, "Публикует события: новые показания", "Kafka")
Rel(automationService, eventBus, "Получает показания, публикует команды по сценариям", "Kafka")
Rel(controlService, eventBus, "Получает команды по сценариям, события об устройствах", "Kafka")

SHOW_LEGEND()
@enduml
